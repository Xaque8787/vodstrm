# Standalone application server
APP_HOST=0.0.0.0
APP_PORT=2112
APP_RELOAD=true
DEBUG=false

# Authentication
# Generate a production key with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
SECURE_COOKIES=false

# Application storage paths (relative paths resolve from the project root)
DATABASE_PATH=data/app.db
SCHEDULER_DB_PATH=data/scheduler.db
DATA_PATH=./data
VOD_PATH=data/vod
VOD_MOVIES_FOLDER=movies
VOD_SERIES_FOLDER=series
VOD_LIVE_TV_FOLDER=livetv
VOD_UNSORTED_FOLDER=unsorted
VOD_UNKNOWN_YEAR_FOLDER=unknown
M3U_DIR=data/m3u
VOD_OFFLINE_PATH=data/vod-offline
LOG_DIR=data/logs

# Scheduling
TZ=America/Los_Angeles

# Docker Compose host paths and container identity
# User/group ID the container runs as (avoids volume permission issues)
# Find yours with: id -u && id -g
PUID=1000
PGID=1000
